# Copy to /opt/tx-client/deploy/.env.docker on the VPS (chmod 600). This is the
# Laravel environment handed to every container. Start from ../.env.example,
# fill in the service credentials, then make sure these keys read as below.

APP_ENV=production
APP_DEBUG=false
APP_URL=https://app.texasrenters.com
# A new key logs everyone out and breaks anything encrypted: set it once.
APP_KEY=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# --- Database: the db container ----------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=client_portal
DB_USERNAME=client_portal
DB_PASSWORD=

# --- Proxies ------------------------------------------------------------------
# Requests reach PHP through host nginx -> the web container, both on Docker
# bridge networks; trusting those keeps the visitor's own IP and https scheme.
TRUSTED_PROXIES=172.16.0.0/12
SESSION_SECURE_COOKIE=true

# --- Reverb -------------------------------------------------------------------
# The browser reaches Reverb through app.texasrenters.com/app (host nginx ->
# web -> reverb). The app itself reaches it container-to-container, so the
# server-side host/port/scheme are the internal ones. REVERB_APP_KEY must equal
# VITE_REVERB_APP_KEY in .env.
BROADCAST_CONNECTION=reverb
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# --- TR Staff Portal (docs/portal-sso.md) --------------------------------------
# Staff sign in through login.texasrenters.com. Residents and owners are never affected.
# CLIENT_ID / CLIENT_SECRET / APP_SLUG come from IT (portal -> Apps -> this app -> Keys).
PORTAL_ENABLED=false
PORTAL_ISSUER=https://login.texasrenters.com
PORTAL_CLIENT_ID=
PORTAL_CLIENT_SECRET=
PORTAL_APP_SLUG=texasrenters-web-app
PORTAL_RECHECK_MINUTES=5
PORTAL_ALLOW_PASSWORD_LOGIN=true
