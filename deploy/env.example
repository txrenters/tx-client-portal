# Copy to /opt/tx-client/deploy/.env on the VPS (chmod 600). Read by Docker
# Compose itself for ${...} interpolation -- NOT the Laravel environment (that
# is .env.docker).

APP_SLUG=txclient
APP_VERSION=latest
HTTP_PORT_RANGE=8080-8081

# The db container's credentials. DB_DATABASE / DB_USERNAME / DB_PASSWORD in
# .env.docker must match. Only read when the volume is first initialised:
# changing them later needs ALTER USER inside Postgres as well.
POSTGRES_DB=client_portal
POSTGRES_USER=client_portal
POSTGRES_PASSWORD=

# Baked into the JS bundle at build time; changing them needs a redeploy.
VITE_APP_NAME="TexasRenters.com"
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=app.texasrenters.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
