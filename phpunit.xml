<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="PROPERTYWARE_DISCOVER_ACCOUNTS" value="false"/>
        <!-- Fake credentials: the client refuses to run without them, and every
             test fakes Propertyware's HTTP. Set here so the suite never picks up
             a developer's real keys from .env, and runs the same in CI. -->
        <env name="PROPERTYWARE_CLIENT_ID" value="testing-client"/>
        <env name="PROPERTYWARE_CLIENT_SECRET" value="testing-secret"/>
        <env name="PROPERTYWARE_SYSTEM_ID" value="1"/>
        <env name="PROPERTYWARE_REQUIRE_CLIENT_EMAIL" value="false"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="LEADS_WEBHOOK_URL" value=""/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="PROPERTYWARE_APPROVAL_TEST_MODE" value="false"/>
        <env name="CHAT_HUB_URL" value=""/>
        <env name="CHAT_HUB_TOKEN" value=""/>
        <env name="CHAT_HUB_WEBHOOK_SECRET" value=""/>
        <!-- Like the hub above: blank, so no test reaches the real listings,
             scheduling or Microsoft services with a developer's .env keys. -->
        <env name="TX_MAINTENANCE_URL" value=""/>
        <env name="TX_MAINTENANCE_TOKEN" value=""/>
        <env name="TX_CMA_URL" value=""/>
        <env name="TX_CMA_TOKEN" value=""/>
        <env name="SCHEDULING_URL" value=""/>
        <env name="SCHEDULING_TOKEN" value=""/>
        <env name="MICROSOFT_TENANT_ID" value=""/>
        <env name="MICROSOFT_CLIENT_ID" value=""/>
        <env name="MICROSOFT_CLIENT_SECRET" value=""/>
    </php>
</phpunit>
