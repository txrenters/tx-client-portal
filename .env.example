APP_NAME="TexasRenters.com"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Production: https://app.texasrenters.com (passkeys, links in emails and the
# mobile app's universal links all follow it).
APP_URL=http://localhost:8000

APP_DISPLAY_TIMEZONE=America/Chicago
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=client_portal
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Mobile apps: enables app links and shared passwords/passkeys (see config/mobile.php)
MOBILE_IOS_APP_IDS=
MOBILE_ANDROID_PACKAGE=
MOBILE_ANDROID_SHA256_CERT_FINGERPRINTS=

# tx-cma: our MLS listings, used for property photos (token = tx-cma's MARKET_API_TOKEN)
TX_CMA_URL=
TX_CMA_TOKEN=

# Shown on the maintenance request form next to "Urgent"
MAINTENANCE_EMERGENCY_PHONE=

# Who may open the admin dashboard and the log viewer, comma separated.
# Admin is deliberately not a role or a column: nothing inside the portal can
# grant it, so a compromised client account cannot escalate into staff access.
ADMIN_EMAILS=

# The load balancer or proxy in front of the app, so the real visitor IP is
# logged and blocked: a comma list of addresses, or * on a managed platform.
# Left empty, no proxy is trusted.
TRUSTED_PROXIES=

# tx-scheduling: staff availability and meeting bookings.
# SCHEDULING_TOKEN is issued in that app under Settings > API keys. The key is
# tied to one organization and the portal asks which, so SCHEDULING_PAGE is
# only needed to override that, or for a key tied to no organization.
SCHEDULING_URL=
SCHEDULING_TOKEN=
SCHEDULING_PAGE=

# The website's owner-leads form webhook (n8n); portal referrals are sent there too.
LEADS_WEBHOOK_URL=

# Expo's push service, which holds our APNs key and FCM credentials and rings
# the mobile app. Nothing here is needed to send: Expo routes on the push token
# the app registers. EXPO_ACCESS_TOKEN is only required once the Expo project
# has enhanced security turned on (expo.dev > project > settings).
EXPO_PUSH_URL=https://exp.host
EXPO_ACCESS_TOKEN=

# Only emails on a Propertyware contact may create a login themselves.
PROPERTYWARE_REQUIRE_CLIENT_EMAIL=true
